{
  "name": "@aerobeat/web-renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE.md",
    "docs/decisions/"
  ],
  "scripts": {
    "check": "npm run check:types && npm run check:jsdoc && npm run check:imports && npm run check:components && npm run check:console && npm run check:renderer",
    "check:types": "tsc --noEmit --allowJs --checkJs --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM src/*.js",
    "check:jsdoc": "node scripts/validate-jsdoc-no-any.js",
    "check:imports": "node scripts/validate-public-imports.js",
    "check:components": "node scripts/validate-component-rules.js",
    "check:console": "node scripts/validate-playwright-console-noise.js",
    "check:renderer": "node scripts/validate-renderer-facade.js",
    "test": "npm run check",
    "test:browser": "npm run check:console && node scripts/validate-browser-renderer.js",
    "demo": "npm --prefix .testbed run demo",
    "testbed:serve": "npm --prefix .testbed run serve"
  },
  "peerDependencies": {
    "@aerobeat/web-contracts": "^0.1.0"
  },
  "devDependencies": {
    "@aerobeat/web-contracts": "file:../aerobeat-web-contracts",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
